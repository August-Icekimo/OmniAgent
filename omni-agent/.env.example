POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omni_agent
POSTGRES_USER=omni
POSTGRES_PASSWORD=your_db_password_here

# LINE
LINE_CHANNEL_SECRET=your_line_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token_here

# BlueBubbles
BLUEBUBBLES_SERVER_URL=
BLUEBUBBLES_PASSWORD=

# LLM
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# Local MLX (chrysoberyl — Rapid-MLX serving gemma-4-26b via Tailscale)
MLX_BASE_URL=http://100.88.136.117:8000/v1
MLX_MODEL=gemma-4-26b
GEMINI_API_KEY=your_gemini_key_here   # Gemini 2.5 Flash via API Key

# Brain
BRAIN_URL=http://brain:8000/chat
BRAIN_PORT=8000

# Gateway
GATEWAY_PORT=8086

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=BYTHESEWORDSIPROTECTMTFAMILY
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_ADMIN_CHAT_ID=123456789
TELEGRAM_STRANGER_REPLY=抱歉，我不認識你。

# Web Search (SearXNG, compose 內網服務)
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change_me_random_string

# Terminal 技能（沙箱 exec 服務，compose 內網；預設值已寫死於 compose.yml）
SANDBOX_URL=http://sandbox:8000

# Terminal Viewer（xterm.js web log 檢視）
# 原始 ANSI log 落地於共享 named volume `terminal-logs`：
#   sandbox 掛 rw 於 LOG_ROOT=/sandbox/logs（寫）
#   brain   掛 rw 於 TERMINAL_LOG_DIR=/terminal-logs（讀 + 7 天保留期清理刪檔）
# 兩者路徑已寫死於 compose.yml，此處列出供查閱。
# 短效 viewer token 的 HMAC 金鑰（必填，否則 viewer 端點回 503）。請填高熵隨機字串：
TERMINAL_VIEW_SECRET=change_me_to_a_long_random_secret
# viewer 連結對外基底（= secure-gateway 的 Caddy 對外網域）。未設定時聊天只回摘要、不附連結：
CINDY_VIEWER_BASE_URL=https://cindy.your-domain.example
# token 壽命（秒，預設 86400=24h）：
TERMINAL_VIEW_TOKEN_TTL=86400
# log 保留天數（預設 7）與清理週期（秒，預設 86400）：
TERMINAL_LOG_RETENTION_DAYS=7
TERMINAL_LOG_CLEANUP_INTERVAL=86400
# 共享 log volume 的擁有者 uid/gid（須等於 sandbox 容器執行身分，預設 10001）。
# brain（root）開機時 chown log 目錄成此擁有者，讓非 root 的 sandbox 可寫入：
TERMINAL_LOG_UID=10001
TERMINAL_LOG_GID=10001

# Skills Server
SKILLS_URL=http://skills:8001
COCKPIT_URL=https://homelab-cockpit:9090
COCKPIT_USER=admin
COCKPIT_PASSWORD=secret
WOL_BROADCAST=255.255.255.255